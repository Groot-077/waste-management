# ================================================================
# Smart Waste Management - Environment Configuration
# ================================================================

# YOLO26 AI Inference Configuration
# Leave blank to use Demo Mode (shows realistic sample classifications)
# Provide your YOLO26 endpoint and API key to enable live AI inference:
YOLO_API_URL=
YOLO_API_KEY=

# Optional: Path to local YOLO model file (e.g. model/best.pt)
YOLO_MODEL_PATH=

# Application Settings
APP_NAME="Smart Waste Management"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (SQLite default for simple local setup)
DATABASE_URL="sqlite:///./waste_management.db"

# Security / Authentication
JWT_SECRET="smart-waste-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# Email Notifications (Optional SMTP setup)
# If blank, notification delivery is simulated and logged to the database
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="noreply@smartwaste.org"
SMTP_USE_TLS=True
